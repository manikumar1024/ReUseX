# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/campusloop

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AI Configuration
# Options: mock | granite | watsonx
AI_MODE=mock

# IBM Watsonx / Granite (only needed when AI_MODE=granite)
IBM_GRANITE_API_KEY=
IBM_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads

# Match score weights (optional, defaults shown)
MATCH_WEIGHT_FUNCTIONAL=0.35
MATCH_WEIGHT_AVAILABILITY=0.20
MATCH_WEIGHT_TIMING=0.15
MATCH_WEIGHT_LOCATION=0.10
MATCH_WEIGHT_CONDITION=0.10
MATCH_WEIGHT_RELIABILITY=0.05
MATCH_WEIGHT_SUSTAINABILITY=0.05
